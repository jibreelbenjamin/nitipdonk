# ─── Supabase (wajib) ─────────────────────────────────────────────────────────
# Semua data & gambar diakses lewat Supabase. Ambil dari Supabase Dashboard →
# Project Settings → API Keys. Kunci ini HANYA dipakai di server, jangan diberi
# prefix NEXT_PUBLIC_.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role atau sb_secret_..."
# Bucket dibuat otomatis (public) saat upload pertama kalau belum ada
SUPABASE_BUCKET="nitipdonk"

# ─── Auth (wajib) ─────────────────────────────────────────────────────────────
# Untuk menandatangani cookie sesi. Buat dengan: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-panjang"
# Password untuk masuk ke /admin
ADMIN_PASSWORD="ganti-password-admin"

# ─── Pembersihan gambar otomatis (opsional) ───────────────────────────────────
# Endpoint GET /api/cron/cleanup dilindungi header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="ganti-dengan-string-acak"
# Bukti bayar yang lebih tua dari N hari akan dihapus oleh cron
CLEANUP_PROOF_DAYS="30"

# ─── Migrasi Prisma (hanya di komputer developer, TIDAK perlu di Vercel) ──────
# Supabase Dashboard → Connect → Session pooler (port 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Opsional, saat membuat migrasi baru dengan database lokal `npm run db:dev`
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
