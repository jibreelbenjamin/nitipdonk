// Prisma hanya dipakai untuk skema & migrasi. Aplikasi mengakses data lewat
// Supabase (supabase-js), jadi id, createdAt, dan updatedAt diisi oleh database.
datasource db {
  provider = "postgresql"
}

enum ImageKind {
  AVATAR // foto profil
  PAYMENT_QR // gambar info pembayaran (QRIS, dsb.)
  PROOF // bukti pembayaran titipan
  TRIP // lampiran dari pembuka titipan (foto menu, daftar harga, syarat, dll.)
}

enum PaymentMethod {
  CASH
  CASHLESS
}

enum TripStatus {
  OPEN // masih menerima titipan
  CLOSED // tidak menerima titipan lagi (sedang dibelikan)
  DONE // selesai
}

model User {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  avatarId         String?   @unique
  avatar           Image?    @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  // Info pembayaran: teks (no. rekening / e-wallet) dan/atau gambar (QRIS)
  paymentInfo      String?
  paymentQrId      String?   @unique
  paymentQr        Image?    @relation("UserPaymentQr", fields: [paymentQrId], references: [id], onDelete: SetNull)
  // PIN opsional; null = akun terbuka tanpa PIN
  pinHash          String?
  pinFailedCount   Int       @default(0)
  pinLockedUntil   DateTime? @db.Timestamptz(3)
  // Dinaikkan setiap PIN berubah supaya sesi lama di perangkat lain ikut keluar
  sessionVersion   Int       @default(0)
  // Dinonaktifkan admin: tidak bisa dipakai, data tetap ada
  isActive         Boolean   @default(true)
  // Saat nonaktif: tetap tampil abu-abu di halaman pilih akun (true) atau disembunyikan (false)
  showWhenInactive Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  trips  Trip[]
  orders Order[]
}

// Satu "titipan live": seseorang pergi beli sesuatu dan membuka titipan untuk yang lain
model Trip {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  hostId    String
  host      User       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title     String
  note      String?
  closesAt  DateTime?  @db.Timestamptz(3)
  status    TripStatus @default(OPEN)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  orders Order[]
  images Image[]

  @@index([status, createdAt])
}

// Satu pesanan titip dalam sebuah Trip
model Order {
  id            String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId        String
  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         String
  price         Int?
  paymentMethod PaymentMethod
  proofId       String?       @unique
  proof         Image?        @relation(fields: [proofId], references: [id], onDelete: SetNull)
  isPaid        Boolean       @default(false)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tripId])
  @@index([userId])
}

// Semua gambar yang tersimpan di storage (sudah dikompres)
model Image {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  kind      ImageKind
  path      String    @unique
  size      Int
  width     Int
  height    Int
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  // Lampiran titipan. SetNull: kalau titipan terhapus tanpa membersihkan gambarnya, barisnya
  // tetap terlihat di admin ("Tidak terpakai") sehingga file di storage bisa dihapus
  tripId    String?
  trip      Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)

  avatarOf    User?  @relation("UserAvatar")
  paymentQrOf User?  @relation("UserPaymentQr")
  proofOf     Order?

  @@index([kind, createdAt])
  @@index([tripId])
}

// Pengaturan aplikasi berbentuk key-value, mis. hash password admin ("adminPasswordHash")
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}
